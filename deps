#!/usr/bin/env bash

set -euo pipefail

usage()
{
    cat >&2 <<'EOF'
Usage: ./deps

Install the system dependencies used by VMNL's build and graphics tooling.
This script is Linux-only and requires /etc/os-release.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

section()
{
    printf '\n==> %s\n' "$*" >&2
}

cmd()
{
    printf '$ %s\n' "$*" >&2
}

ok()
{
    printf '[Success] %s\n' "$*" >&2
}

die()
{
    printf '[Error] %s\n' "$*" >&2
    exit 1
}

require_cmd()
{
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

load_os_release()
{
    [[ -r /etc/os-release ]] || die "/etc/os-release not found"
    # shellcheck disable=SC1091
    . /etc/os-release
}

install_packages()
{
    section "Installing system dependencies"
    printf 'ID: %s\n' "${ID:-unknown}" >&2
    printf 'ID_LIKE: %s\n' "${ID_LIKE:-unknown}" >&2

    case "${ID:-}" in
        fedora)
            cmd "sudo dnf install -y libshaderc-devel libshaderc-static pkgconf-pkg-config cmake git python3 ninja-build gcc-c++ make vulkan-loader-devel vulkan-tools wayland-devel wayland-protocols-devel libxkbcommon-devel libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel"
            sudo dnf install -y \
                libshaderc-devel libshaderc-static \
                pkgconf-pkg-config cmake git python3 ninja-build \
                gcc-c++ make \
                vulkan-loader-devel vulkan-tools \
                wayland-devel wayland-protocols-devel libxkbcommon-devel \
                libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel
            ;;
        rhel|centos|rocky|almalinux)
            cmd "sudo dnf install -y shaderc-devel pkgconf-pkg-config cmake git python3 ninja-build gcc-c++ make vulkan-loader-devel vulkan-tools wayland-devel wayland-protocols-devel libxkbcommon-devel libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel"
            sudo dnf install -y \
                shaderc-devel \
                pkgconf-pkg-config cmake git python3 ninja-build \
                gcc-c++ make \
                vulkan-loader-devel vulkan-tools \
                wayland-devel wayland-protocols-devel libxkbcommon-devel \
                libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel
            ;;
        ubuntu|debian)
            cmd "sudo apt-get update"
            sudo apt-get update
            cmd "sudo apt-get install -y libshaderc-dev pkg-config cmake git python3 ninja-build build-essential libvulkan-dev vulkan-tools libwayland-dev wayland-protocols libxkbcommon-dev xorg-dev"
            sudo apt-get install -y \
                libshaderc-dev \
                pkg-config cmake git python3 ninja-build \
                build-essential \
                libvulkan-dev vulkan-tools \
                libwayland-dev wayland-protocols libxkbcommon-dev xorg-dev
            ;;
        arch)
            cmd "sudo pacman -Sy --needed shaderc pkgconf cmake git python ninja base-devel vulkan-headers vulkan-tools wayland wayland-protocols libxkbcommon libxcursor libxi libxinerama libxrandr"
            sudo pacman -Sy --needed \
                shaderc pkgconf cmake git python ninja \
                base-devel \
                vulkan-headers vulkan-tools \
                wayland wayland-protocols libxkbcommon \
                libxcursor libxi libxinerama libxrandr
            ;;
        opensuse*|sles)
            cmd "sudo zypper --non-interactive install shaderc shaderc-devel pkg-config cmake git python3 ninja gcc-c++ make vulkan-devel vulkan-tools wayland-devel wayland-protocols-devel libxkbcommon-devel libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel"
            sudo zypper --non-interactive install \
                shaderc shaderc-devel \
                pkg-config cmake git python3 ninja \
                gcc-c++ make \
                vulkan-devel vulkan-tools \
                wayland-devel wayland-protocols-devel libxkbcommon-devel \
                libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel
            ;;
        *)
            case "${ID_LIKE:-}" in
                *fedora*|*rhel*)
                    cmd "sudo dnf install -y shaderc-devel pkgconf-pkg-config cmake git python3 ninja-build gcc-c++ make vulkan-loader-devel vulkan-tools wayland-devel wayland-protocols-devel libxkbcommon-devel libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel"
                    sudo dnf install -y \
                        shaderc-devel \
                        pkgconf-pkg-config cmake git python3 ninja-build \
                        gcc-c++ make \
                        vulkan-loader-devel vulkan-tools \
                        wayland-devel wayland-protocols-devel libxkbcommon-devel \
                        libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel
                    ;;
                *debian*)
                    cmd "sudo apt-get update"
                    sudo apt-get update
                    cmd "sudo apt-get install -y libshaderc-dev pkg-config cmake git python3 ninja-build build-essential libvulkan-dev vulkan-tools libwayland-dev wayland-protocols libxkbcommon-dev xorg-dev"
                    sudo apt-get install -y \
                        libshaderc-dev \
                        pkg-config cmake git python3 ninja-build \
                        build-essential \
                        libvulkan-dev vulkan-tools \
                        libwayland-dev wayland-protocols libxkbcommon-dev xorg-dev
                    ;;
                *arch*)
                    cmd "sudo pacman -Sy --needed shaderc pkgconf cmake git python ninja base-devel vulkan-headers vulkan-tools wayland wayland-protocols libxkbcommon libxcursor libxi libxinerama libxrandr"
                    sudo pacman -Sy --needed \
                        shaderc pkgconf cmake git python ninja \
                        base-devel \
                        vulkan-headers vulkan-tools \
                        wayland wayland-protocols libxkbcommon \
                        libxcursor libxi libxinerama libxrandr
                    ;;
                *suse*)
                    cmd "sudo zypper --non-interactive install shaderc shaderc-devel pkg-config cmake git python3 ninja gcc-c++ make vulkan-devel vulkan-tools wayland-devel wayland-protocols-devel libxkbcommon-devel libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel"
                    sudo zypper --non-interactive install \
                        shaderc shaderc-devel \
                        pkg-config cmake git python3 ninja \
                        gcc-c++ make \
                        vulkan-devel vulkan-tools \
                        wayland-devel wayland-protocols-devel libxkbcommon-devel \
                        libXcursor-devel libXi-devel libXinerama-devel libXrandr-devel
                    ;;
                *)
                    die "unsupported OS: ID='${ID:-unknown}', ID_LIKE='${ID_LIKE:-unknown}'"
                    ;;
            esac
            ;;
    esac

    ok "system dependencies installation completed"
}

load_os_release
require_cmd sudo
install_packages
